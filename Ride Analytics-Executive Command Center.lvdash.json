{
  "datasets": [
    {
      "name": "304bc511",
      "displayName": "Live KPIs",
      "queryLines": [
        "select\n",
        "  event_date,\n",
        "  total_revenue_inr,\n",
        "  cancellation_rate_pct,\n",
        "  active_drivers,\n",
        "  avg_fare_inr,\n",
        "  cast(round(total_rides * (100 - cancellation_rate_pct) / 100, 0) as bigint) as completed_rides\n",
        "from\n",
        "  databrickslearning.realtime.gold_live_kpis"
      ],
      "catalog": "databrickslearning",
      "schema": "realtime"
    },
    {
      "name": "04c9c861",
      "displayName": "Revenue Per Minute",
      "queryLines": [
        "select \r\n",
        "minute_bucket,\r\n",
        "revenue_inr,\r\n",
        "completed_rides\r\n",
        "from \r\n",
        "databrickslearning.realtime.gold_revenue_per_minute"
      ],
      "catalog": "databrickslearning",
      "schema": "realtime"
    },
    {
      "name": "3a82704e",
      "displayName": "Ride Status Mix",
      "queryLines": [
        "select \r\n",
        "status,cast(ride_count as bigint) as rider_count\r\n",
        "from databrickslearning.realtime.gold_ride_status_breakdown\r\n",
        "order by rider_count desc"
      ],
      "catalog": "databrickslearning",
      "schema": "realtime"
    },
    {
      "name": "3d94be3a",
      "displayName": "City Performance",
      "queryLines": [
        "SELECT city, ROUND(revenue_inr, 0) AS revenue_inr FROM databrickslearning.realtime.gold_rides_by_city ORDER BY revenue_inr DESC"
      ],
      "catalog": "databrickslearning",
      "schema": "realtime"
    },
    {
      "name": "10b7c586",
      "displayName": "Top Revenue Zone",
      "queryLines": [
        "SELECT zone_id, city, ROUND(total_revenue_inr, 0) AS total_revenue_inr, CAST(completed_rides AS BIGINT) AS completed_rides,\r\n",
        " ROUND(avg_fare_inr, 0) AS avg_fare_inr \r\n",
        "FROM databrickslearning.realtime.gold_top_zones \r\n",
        "ORDER BY total_revenue_inr DESC LIMIT 10"
      ],
      "catalog": "databrickslearning",
      "schema": "realtime"
    },
    {
      "name": "f10107f0",
      "displayName": "Cancellation Reasons",
      "queryLines": [
        "SELECT city, COALESCE(NULLIF(cancellation_reason,''), status) AS reason, CAST(SUM(cancellation_count) AS BIGINT) AS cancellation_count \r\n",
        "FROM databrickslearning.realtime.gold_cacellation_analysis\r\n",
        " GROUP BY city, COALESCE(NULLIF(cancellation_reason,''), status) ORDER BY cancellation_count DESC"
      ]
    },
    {
      "name": "a513e874",
      "displayName": "Pickup Demand",
      "queryLines": [
        "SELECT city, pickup_area, zone_id, CAST(SUM(total_rides) AS BIGINT) AS total_rides, CAST(SUM(cancelled_rides) AS BIGINT) AS cancelled_rides, ROUND(SUM(cancelled_rides) * 100.0 / NULLIF(SUM(total_rides), 0), 1) AS cancel_rate_pct \r\n",
        "FROM databrickslearning.realtime.gold_pickup_demand GROUP BY city, pickup_area, zone_id ORDER BY total_rides DESC"
      ],
      "catalog": "databrickslearning",
      "schema": "realtime"
    }
  ],
